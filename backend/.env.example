# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio_ai

# PostgreSQL (Local pgAdmin or Cloud Supabase/Neon)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=portfolio_mlops_db
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/portfolio_mlops_db

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Portfolio defaults
REBALANCE_DAYS=21
COST_RATE=0.001
VOL_TARGET=0.15

# ML flags
SKIP_GARCH=false
MODEL_START_DATE=2005-01-01
MODEL_SPLIT_DATE=2020-01-01
CHECKPOINT_DIR=checkpoints

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
